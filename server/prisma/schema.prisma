generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Administrador {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("administradores")
}

model Especialidad {
  id      String   @id @default(cuid())
  nombre  String   @unique
  medicos Medico[]

  @@map("especialidades")
}

model Medico {
  id             String       @id @default(cuid())
  nombre         String
  email          String       @unique
  createdAt      DateTime     @default(now())
  especialidadId String
  horarios       Horario[]
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id])

  @@map("medicos")
}

model Horario {
  id         String    @id @default(cuid())
  medicoId   String
  diaSemana  DiaSemana
  horaInicio String
  horaFin    String
  cupos      Int
  createdAt  DateTime  @default(now())
  citas      Cita[]
  medico     Medico    @relation(fields: [medicoId], references: [id], onDelete: Cascade)

  @@map("horarios")
}

model Cita {
  id             String     @id @default(cuid())
  horarioId      String
  fecha          DateTime
  estado         EstadoCita @default(ACTIVA)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  pacienteDni    String
  pacienteNombre String
  pacienteTelef  String
  horario        Horario    @relation(fields: [horarioId], references: [id])

  @@index([pacienteTelef])
  @@map("citas")
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
}

enum EstadoCita {
  ACTIVA
  CANCELADA
  FINALIZADO
}
